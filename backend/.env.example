# Model & Provider Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Memory & Persistence Configuration
# Options: "sqlite" | "supabase"
