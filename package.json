{
  "name": "ditroy",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node shared/scripts/dev.js",
    "dev:cloud": "node shared/scripts/dev.js --cloud",
    "dev:ollama": "node shared/scripts/dev.js --ollama",
    "start:backend": "node shared/scripts/dev.js --prod --backend-only",
    "start:backend:ollama": "node shared/scripts/dev.js --prod --backend-only --ollama",
    "build": "turbo run build",
    "lint": "node shared/scripts/lint.js",
    "test": "node shared/scripts/test.js",
    "test:load": "k6 run loadTester.js",
    "test:load:local": "k6 run -e TARGET_URL=http://localhost:3000 loadTester.js",
    "test:load:live": "k6 run -e TARGET_URL=https://your-domain.vercel.app loadTester.js",
    "test:load:render": "k6 run -e TARGET_URL=https://ditroy.onrender.com loadTester.js",
    "seeResult": "node -e \"const fs = require('fs'); if (!fs.existsSync('summary.html')) { console.error('❌ summary.html not found. Run a load test first with: npm run test:load:local'); process.exit(1); } const {exec} = require('child_process'); const p = process.platform === 'win32' ? 'start summary.html' : process.platform === 'darwin' ? 'open summary.html' : 'xdg-open summary.html'; exec(p);\"",
    "test:load:all": "k6 run loadTester.js",
    "test:load:frontend": "k6 run -e TARGET_URL=http://localhost:3000 loadTester.js",
    "test:load:backend": "k6 run -e TARGET_URL=http://localhost:8000 loadTester.js",
    "test:load:client": "k6 run -e TARGET_URL=http://localhost:3000 loadTester.js",
    "test:load:help": "npx loadtester-kit commands"
  },
  "devDependencies": {
    "loadtester-kit": "^1.1.3",
    "turbo": "^2.11.9"
  },
  "packageManager": "pnpm@12.14.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "shared/*"
  ]
}
