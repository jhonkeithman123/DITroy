MEMORY_TOKEN_BUDGET=768

# Supabase Cloud Database Configuration
SUPABASE_URL=https://iaqvdbifphbvehwuohym.supabase.co
# Get the service_role secret key from Supabase Dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Host & Port
API_HOST=0.0.0.0
API_PORT=8000
