# Model & Provider Configuration
# Options: "fallback" (Recommended: Auto-failover pool) | "groq" | "gemini" | "deepseek" | "zai" | "ollama" | "stub"
MODEL_PROVIDER=fallback

# Automatic Failover Priority Chain (comma-separated, tried in order)
FALLBACK_PROVIDERS=groq,gemini,deepseek,zai,ollama

# Specific Model Overrides (Optional - defaults are automatically selected per provider)
# MODEL_NAME=gemini-2.0-flash

# --- Cloud AI Provider API Keys ---
# 1. Groq (Ultra-fast LPU inference: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini (Generous free tier: 15 RPM, 1M TPM: https://aistudio.google.com)
# Models: "gemini-2.0-flash" | "gemini-1.5-flash" | "gemini-1.5-pro"
GEMINI_API_KEY=your_gemini_api_key_here

# 3. DeepSeek (Reasoning & Chat: https://platform.deepseek.com)
# Models: "deepseek-chat" (V3) | "deepseek-reasoner" (R1 reasoning chain)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 4. Z.AI / Zhipu GLM (Generous GLM-4 free tier: https://open.bigmodel.cn)
# Models: "glm-4-flash" | "glm-4"
ZAI_API_KEY=your_zai_api_key_here

# --- Local Ollama Configuration (Zero-limit local fallback) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Memory & Persistence Configuration ---
# Options: "supabase" (Cloud - Recommended for Render) | "sqlite" (Local)
MEMORY_BACKEND=supabase
MEMORY_PATH=./data/memory.sqlite3
MEMORY_TOKEN_BUDGET=768

# Supabase Cloud Database Configuration
SUPABASE_URL=https://iaqvdbifphbvehwuohym.supabase.co
# Get the service_role secret key from Supabase Dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Exclusive Cron / Keepalive Configuration (Optional)
# If set, calls to /api/cron/keepalive require Authorization: Bearer <secret>, X-Cron-Key, or ?key=<secret>
CRON_SECRET=your_optional_cron_secret_here
